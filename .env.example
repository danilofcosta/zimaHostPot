# ---------------------------------------------------------------------------
# Zima Hotspot UI (Next.js BFF)
# Copie para ui/.env (ou exporte no compose) e ajuste os valores.
# ---------------------------------------------------------------------------

# Onde o Next.js escuta dentro do container.
PORT=80
HOSTNAME=0.0.0.0

# URL exata usada no navegador (origem confiável do Better Auth). Ex.:
# http://192.168.0.104:8080
BETTER_AUTH_URL=http://localhost:8080

# Segredo do Better Auth (>= 32 caracteres aleatórios). Gere com:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret

# Origens extras confiáveis, separadas por vírgula (opcional). As redes
# privadas 10/8, 172.16/12, 192.168/16 na porta 8080 já são aceitas.
# BETTER_AUTH_TRUSTED_ORIGINS=http://zimaos.local:8080

# Cookies Secure: habilite apenas quando a UI for servida por HTTPS.
BETTER_AUTH_SECURE=false

# Endereço interno da API Python. No compose, a UI alcança o container
# host-network via host.docker.internal.
HOTSPOT_API_URL=http://host.docker.internal:6565

# Mesma chave configurada em server/.env (API_KEY). Nunca vai para o browser.
# API_KEY=change-me

# Banco SQLite compartilhado com o backend Python. No compose o volume
# ./server/data é montado em /app/data.
DATABASE_PATH=/app/data/database.db

# Conta criada apenas no primeiro boot, quando o banco não tem usuários.
# INITIAL_ADMIN_USERNAME=casaos
# INITIAL_ADMIN_PASSWORD=casaosos
