# ---------------------------------------------------------------------------
# Configuração do `docker compose` (raiz do projeto)
#
#   cp .env.example .env
#
# O `.env` é ignorado pelo Git. Gere segredos novos com:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------

# Chave compartilhada entre a UI e a API Python (header X-API-Key).
# Obrigatória em produção: a API se recusa a iniciar sem ela.
API_KEY=change-me-to-a-long-random-key

# Segredo do Better Auth (>= 32 caracteres aleatórios).
BETTER_AUTH_SECRET=change-me-to-another-long-random-secret

# Origens aceitas pela API (separadas por vírgula, sem "*").
# A UI fala com a API pelo servidor Next (sem CORS), então esta lista é só um
# reforço. Inclua a origem do painel caso chame a API direto do navegador.
CORS_ORIGINS=http://localhost:8080

# URL pública do painel (ex.: http://192.168.0.10:8080). Se ficar vazia, o
# Better Auth usa o host da requisição, o que funciona por qualquer IP da LAN.
# BETTER_AUTH_URL=

# Senha inicial do administrador (mínimo de 12 caracteres). O primeiro login
# exige a troca. A conta é criada apenas quando o banco ainda não tem usuários.
HOTSPOT_ADMIN_PASSWORD=change-me-admin-password

# Usuário inicial do painel.
# INITIAL_ADMIN_USERNAME=casaos

# Interface Wi-Fi usada pelo hotspot no ZimaOS.
DEFAULT_INTERFACE=wlan0

# URL da API gravada no bundle do navegador durante o build. Use o IP do
# ZimaOS para acessar o painel de outra máquina (ex.: http://192.168.0.10:6565).
NEXT_PUBLIC_API_URL=http://localhost:6565

# Endereço interno da API Python usado pelo servidor Next (BFF).
# Padrão: http://host.docker.internal:6565 (Linux/ZimaOS com a API em
# network_mode: host). No Docker Desktop (Windows/macOS), onde o host real não
# enxerga a rede do container, use o gateway da rede do compose. Descubra com:
#   docker network inspect zimahostpot_default -f "{{ (index .IPAM.Config 0).Gateway }}"
# HOTSPOT_API_URL=http://172.18.0.1:6565
