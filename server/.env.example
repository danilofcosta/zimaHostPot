# Application
APP_NAME=Zima Hotspot API
APP_VERSION=1.0.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=6565
LOG_LEVEL=INFO
# Swagger/OpenAPI. Defaults to true in development and false in production.
# DOCS_ENABLED=false
RELOAD=false

# Security ---------------------------------------------------------------
# When set, every /api/v1 endpoint requires the X-API-Key header.
# Required in production: the API is NOT allowed to start without it.
# API_KEY=change-me

# CORS (comma separated). Use an explicit origin list in production
# (e.g. http://192.168.1.10:8080). Production refuses to start with "*".
CORS_ORIGINS=*

# Escape hatch for labs only. When true, production starts even with API_KEY
# unset or CORS_ORIGINS=*, and logs a warning on every boot.
# ALLOW_INSECURE_PRODUCTION=false

# Hotspot defaults
DEFAULT_INTERFACE=wlan0
DEFAULT_PROFILE_NAME=Hotspot

# Persistence -------------------------------------------------------------
# Where the last used hotspot settings are persisted as JSON (SSID, password,
# interface, band, channel and profile name). In Docker the compose file mounts
# ./server/data as /app/data, so this survives image rebuilds.
# HOTSPOT_CONFIG_FILE=/app/data/hotspot.json
# DATA_DIR=/app/data
# DB_PATH=/app/data/database.db

# Retention ---------------------------------------------------------------
# Traffic samples (bytes/packets used by the charts).
# MONITOR_RETENTION_HOURS=72
# Connection and event history (device connect/disconnect, admin actions).
# EVENT_RETENTION_HOURS=168
# MONITOR_INTERVAL_SECONDS=10

# Optional integrations ---------------------------------------------------
# OUI database used to resolve MAC vendors (falls back to the built-in table).
# OUI_FILE=/app/data/oui.txt
# ZIMAOS_API_URL=https://zimaos.local/api
# ZIMAOS_API_KEY=
